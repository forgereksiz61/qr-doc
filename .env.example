# QR kodunun açacağı adres. İlk test için bu değer yeterlidir.
# Telefonla denemek için bilgisayarın aynı ağdaki adresini yazın:
# SITE_URL=http://192.168.x.x:3000
SITE_URL=http://localhost:3000

# İçe aktarılacak PDF klasörü. Alt klasörler de taranır.
# PDF_IMPORT_DIR=C:\path\to\pdfs

# Güncellenmiş PDF klasörü. blob:upload bunu okur.
# PDF_UPDATED_DIR=C:\path\to\updated-pdfs

# Vercel Private Blob. Değeri bu dosyaya yazma.
# BLOB_READ_WRITE_TOKEN=
